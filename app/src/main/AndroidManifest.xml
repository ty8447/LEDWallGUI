<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:theme="@style/DarkAppTheme"
        tools:targetApi="31">

        <activity
            android:name=".ui.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    <activity android:name=".ui.modes.AnimationStudioActivity" android:exported="false" />
    <activity android:name=".ui.settings.AboutActivity" android:exported="false" />
    <activity android:name=".ui.settings.DisplaySettingsActivity" android:exported="false" />
    <activity android:name=".ui.settings.ControllerSetupActivity" android:exported="false" />
    <activity android:name=".ui.settings.RoomWizardActivity" android:exported="false" />
    <activity android:name=".ui.settings.LedCalibrationActivity" android:exported="false" />
    <activity android:name=".ui.WelcomeTourActivity" android:exported="false" />
    <activity
            android:name="com.example.ledwallgui.ui.settings.settingsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.ledwallgui.ui.alarm.AlarmActivity"
            android:exported="false" />
        <activity
            android:name="com.example.ledwallgui.ui.AlarmAlertActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <activity
            android:name="com.example.ledwallgui.ui.modes.ModesActivity"
            android:exported="false"
            android:label="@string/title_activity_modes"
            android:theme="@style/Theme.LEDWallGUI" />
        <activity
            android:name="com.example.ledwallgui.ui.alarm.AlarmEditorActivity"
            android:exported="false" />
        <activity
            android:name="com.example.ledwallgui.ui.settings.ConnectionActivity"
            android:exported="false" />
        <activity
            android:name="com.example.ledwallgui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/DarkAppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Camera motion analysis is tied to the visible MainActivity, not a background service. -->
        <service android:name=".ui.AudioReactiveService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".services.BluetoothReconnectionService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <service
            android:name=".TimeMonitoringService"
            android:exported="false" />

        <receiver android:name=".ui.alarm.AlarmReceiver" />



    </application>

</manifest>