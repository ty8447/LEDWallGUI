<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContainer" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#121721">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
    <TextView android:id="@+id/textView" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="@string/led_controller" android:textColor="@color/white"
        android:textSize="23sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal"
        android:gravity="center_vertical">
      <ImageButton android:id="@+id/imageButton1" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="56dp" android:src="@drawable/power_button_off_selector" android:scaleType="centerInside"
          android:background="@drawable/transparent_background" android:contentDescription="@string/powerbutton" />
      <ImageButton android:id="@+id/modesbutton" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="56dp" android:src="@drawable/modes_button_selector" android:scaleType="centerInside"
          android:background="@drawable/transparent_background" android:contentDescription="@string/modesbutton" />
      <ImageView android:id="@+id/imageView" android:layout_width="0dp" android:layout_weight="0.6"
          android:layout_height="42dp" android:scaleType="centerInside"
          android:contentDescription="@string/connection" app:srcCompat="@drawable/stat_dis_button" />
      <ImageButton android:id="@+id/imageButton2" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="56dp" android:src="@drawable/alarm_button_selector" android:scaleType="centerInside"
          android:background="@drawable/transparent_background" android:contentDescription="@string/alarmbutton" />
      <ImageButton android:id="@+id/imageButton3" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="56dp" android:src="@drawable/settings_button_selector" android:scaleType="centerInside"
          android:background="@drawable/transparent_background" android:contentDescription="@string/button" />
    </LinearLayout>
    <View android:id="@+id/settingModeDivider" android:layout_width="match_parent" android:layout_height="2dp"
        android:layout_marginTop="8dp" android:background="@color/light_blue" />
    <TextView android:id="@+id/textView5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="9dp" android:paddingBottom="6dp" android:gravity="center" android:text="@string/mode"
        android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:baselineAligned="false" android:paddingBottom="4dp">
      <ScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
          android:fillViewport="false" android:clipToPadding="false">
        <FrameLayout android:id="@+id/dynamicLayoutContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingBottom="12dp" />
      </ScrollView>
      <!-- Portrait brightness rail styled like the landscape slider. -->
      <LinearLayout android:layout_width="88dp" android:layout_height="match_parent"
          android:layout_marginStart="6dp" android:orientation="vertical"
          android:gravity="center_horizontal" android:paddingBottom="4dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Brightness" android:textSize="12sp" android:textColor="#D8E6F2"
            android:gravity="center" android:paddingBottom="6dp" />
        <FrameLayout android:id="@+id/sliderContainer" android:layout_width="70dp"
            android:layout_height="0dp" android:layout_weight="1"
            android:minHeight="200dp">
          <FrameLayout android:id="@+id/sliderBackground" android:layout_width="match_parent"
              android:layout_height="match_parent" android:layout_margin="8dp"
              android:background="@drawable/slider_background" android:clipToOutline="true">
            <View android:id="@+id/sliderThumb" android:layout_width="match_parent"
                android:layout_height="7dp" android:layout_gravity="bottom"
                android:background="@drawable/slider_thumb" />
            <ImageView android:id="@+id/sunIcon" android:layout_width="32dp"
                android:layout_height="32dp" android:layout_gravity="center"
                android:scaleType="centerInside" android:contentDescription="Brightness"
                app:srcCompat="@drawable/sun_svg" />
          </FrameLayout>
          <View android:id="@+id/blackBorder" android:layout_width="match_parent"
              android:layout_height="match_parent" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/brightnessValueLabel" android:layout_width="match_parent"
            android:layout_height="36dp" android:text="0%" android:textColor="#D1D1D1"
            android:textStyle="bold" android:textSize="20sp" android:gravity="center" />
      </LinearLayout>
    </LinearLayout>
    <!-- No persistent color wheel on Home. The Custom Color popup already owns it. -->
  </LinearLayout>
  <FrameLayout android:id="@+id/recordOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
      android:background="@drawable/red_outline" android:visibility="gone">
    <Button android:id="@+id/recordDoneButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="16dp"
        android:text="Capture LED State" android:textColor="@android:color/white"
        android:background="@drawable/rounded_background" android:visibility="gone" />
  </FrameLayout>
</FrameLayout>
