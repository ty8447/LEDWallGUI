<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        tools:ignore="UselessParent">

        <ImageButton
            android:id="@+id/imageButton1"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginTop="3dp"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="0dp"
            android:background="@drawable/transparent_background"
            android:contentDescription="@string/button"
            android:src="@drawable/power_button_off_selector"
            android:scaleType="centerInside" />


        <ImageButton
            android:id="@+id/modesbutton"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginLeft="35dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="25dp"
            android:background="@drawable/transparent_background"
            android:contentDescription="Button"
            android:src="@drawable/modes_button_selector"
            android:scaleType="centerInside"
            />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:text="LED Controller"
            android:textAlignment="center"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center_horizontal" />


        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="17dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            app:srcCompat="@drawable/stat_dis_button"
            android:contentDescription="Connection"
            android:background="@drawable/transparent_background"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/imageButton2"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginTop="3dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/button"
            android:src="@drawable/alarm_button_selector"
            android:background="@drawable/transparent_background"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/imageButton3"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginTop="3dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/button"
            android:src="@drawable/settings_button_selector"
            android:background="@drawable/transparent_background"
            android:scaleType="centerInside" />


    </LinearLayout>

</LinearLayout>
