<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:padding="12dp"
    android:background="#1B2331">
    <TextView
        android:id="@+id/pinDisplayText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="56dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:text="Enter PIN" />
    <GridLayout
        android:id="@+id/keypadLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:rowCount="4"
        android:columnCount="3"
        android:alignmentMode="alignMargins">
        <Button android:id="@+id/num1" android:text="1" android:textSize="24sp"
            android:layout_row="0" android:layout_column="0" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num2" android:text="2" android:textSize="24sp"
            android:layout_row="0" android:layout_column="1" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num3" android:text="3" android:textSize="24sp"
            android:layout_row="0" android:layout_column="2" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num4" android:text="4" android:textSize="24sp"
            android:layout_row="1" android:layout_column="0" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num5" android:text="5" android:textSize="24sp"
            android:layout_row="1" android:layout_column="1" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num6" android:text="6" android:textSize="24sp"
            android:layout_row="1" android:layout_column="2" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num7" android:text="7" android:textSize="24sp"
            android:layout_row="2" android:layout_column="0" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num8" android:text="8" android:textSize="24sp"
            android:layout_row="2" android:layout_column="1" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num9" android:text="9" android:textSize="24sp"
            android:layout_row="2" android:layout_column="2" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/clearButton" android:text="Clear" android:textSize="17sp"
            android:layout_row="3" android:layout_column="0" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/num0" android:text="0" android:textSize="24sp"
            android:layout_row="3" android:layout_column="1" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/pinSubmitButton" android:text="OK" android:textSize="17sp"
            android:layout_row="3" android:layout_column="2" android:layout_columnWeight="1"
            android:layout_width="0dp" android:layout_height="52dp" android:minWidth="0dp"
            android:layout_gravity="fill_horizontal" />
    </GridLayout>
    <Button android:id="@+id/controllerResetButton"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="6dp" android:text="Reset controller setup"
        android:textSize="16sp" android:visibility="gone"
        android:contentDescription="Back up controller settings and reset setup with current PIN" />
</LinearLayout>
