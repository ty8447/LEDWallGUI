<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp"
    android:background="@drawable/rounded_background">

    <!-- Title of the parameter -->
    <TextView
        android:id="@+id/parameterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/parameter_title"
        android:background="@drawable/transparent_background"
        android:textSize="30sp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal" />

    <!-- Spinner for selecting color options -->
    <Spinner
        android:id="@+id/colorDropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Custom SeekBar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="15dp"
        android:background="@drawable/transparent_background">


        <!-- SeekBar for adjusting parameter value -->
        <SeekBar
            android:id="@+id/parameterSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_background"
            android:fadingEdge="horizontal"
            android:thumbOffset="15dp"
            android:max="100"
            android:progressDrawable="@drawable/parameter_seekbar"
            android:splitTrack="false"
            android:thumb="@drawable/parameter_thumb"
            android:visibility="gone"/>

        <!-- Text to show the current value inside the SeekBar thumb -->
        <TextView
            android:id="@+id/parameterValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0"
            android:textSize="18sp"
            android:background="@drawable/transparent_background"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
