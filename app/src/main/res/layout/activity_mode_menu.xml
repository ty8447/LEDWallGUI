<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

            <ImageButton
                android:id="@+id/mBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/back_normal"
                android:background="@drawable/transparent_background"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="5dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="25dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modes"
                android:textSize="50dp" />
        </TableRow>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode1"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode2"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode3"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode4"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode5"
                style="@style/RoundedModeButton"
                android:text="" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode6"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode7"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode8"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode9"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode10"
                style="@style/RoundedModeButton"
                android:text="" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode11"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode12"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode13"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode14"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode15"
                style="@style/RoundedModeButton"
                android:text="" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode16"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode17"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode18"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode19"
                style="@style/RoundedModeButton"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/mode20"
                style="@style/RoundedModeButton"
                android:text=""
                />
        </TableRow>
    </TableLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
