<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modeMenuContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Existing content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <GridLayout
            android:id="@+id/modesContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="70dp"
            android:columnCount="5"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button android:id="@+id/animationStudioButton"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_margin="12dp" android:paddingHorizontal="18dp"
            android:layout_marginEnd="18dp" android:text="Animation Studio"
            android:textAllCaps="false" android:textColor="@color/white"
            android:background="@drawable/settings_button_color_background_selector"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/mBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="16dp"
            android:background="@drawable/transparent_background"
            android:src="@drawable/back_normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Overlay for record mode -->
    <FrameLayout
        android:id="@+id/recordOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/red_outline"
        android:visibility="gone">

    <!-- Done button at the bottom center -->
    <Button
        android:id="@+id/recordDoneButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Capture LED State"
        android:textColor="@android:color/white"
        android:background="@drawable/rounded_background"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp" />
</FrameLayout>

    </FrameLayout>
