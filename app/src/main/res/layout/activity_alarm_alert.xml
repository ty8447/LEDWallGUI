<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Alarm Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <TextView
        android:id="@+id/textViewAlarmTime"
        android:background="@drawable/transparent_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:textSize="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:text="08:00 AM" />

    <TextView
        android:id="@+id/textViewAlarmName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/transparent_background"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:textSize="35sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/textViewAlarmTime"
        android:text="Wake Up Alarm" />

        <Button
            android:id="@+id/buttonDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:backgroundTint="@color/clicked_item_background"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            android:text="Dismiss"
            android:textSize="40dp"
            android:layout_centerHorizontal="true" />
    <Button
        android:id="@+id/buttonSnooze"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:text="Snooze"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/textViewAlarmName"
        android:textSize="40dp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/clicked_item_background" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
