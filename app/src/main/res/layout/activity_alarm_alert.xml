<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">

        <TextView
            android:id="@+id/textViewAlarmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="80dp"
            android:text="08:00 AM"
            android:layout_marginTop="100dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewAlarmName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="35sp"
            android:layout_marginTop="20dp"
            android:text="Wake Up Alarm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewAlarmTime" />

        <!-- Dismiss Button -->
        <Button
            android:id="@+id/buttonDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:backgroundTint="@color/clicked_item_background"
            android:textColor="@color/white"
            android:text="Dismiss"
            android:textSize="40dp"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true"
            app:layout_constraintBottom_toTopOf="@+id/linearLayoutSnooze"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="100dp"
            android:padding="10dp"
            android:background="@drawable/rounded_background" />

        <!-- Snooze Buttons -->
        <LinearLayout
            android:id="@+id/linearLayoutSnooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="20dp">

            <!-- Minus Button -->
            <Button
                android:id="@+id/buttonSnoozeMinus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-"
                android:textSize="30sp"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/clicked_item_background" />

            <!-- Snooze Button Text -->
            <Button
                android:id="@+id/buttonSnooze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="Snooze 5 Minute(s)"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/clicked_item_background" />

            <!-- Plus Button -->
            <Button
                android:id="@+id/buttonSnoozePlus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+"
                android:layout_marginStart="8dp"
                android:textSize="30sp"
                android:textColor="@color/white"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/clicked_item_background" />
        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
