<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <!-- Back Button: Positioned to the start of the parent (left side) -->
    <ImageButton
        android:id="@+id/cBackButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/transparent_background"
        android:scaleType="centerInside"
        android:src="@drawable/back_normal" />

    <!-- Connection TextView: Positioned to the right of the back button -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connection"
        android:textColor="@color/white"
        android:textSize="50sp"
        android:layout_toEndOf="@id/cBackButton"
        android:layout_alignBaseline="@id/cBackButton"
        android:layout_marginStart="10dp"
        android:layout_alignParentTop="true" />

    <!-- Scan for Devices TextView: Positioned below the first TextView -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scanning for Devices"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:layout_below="@id/textView2"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"/>

    <!-- Rescan Button: Positioned immediately to the right of textView3 -->

    <!-- RecyclerView: Positioned below the Rescan button and stretched across the screen -->
    <ImageButton
        android:id="@+id/rescanButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_below="@id/textView2"
        android:layout_marginStart="10dp"
        android:layout_marginTop="13dp"
        android:layout_toEndOf="@id/textView3"
        android:background="@drawable/transparent_background"
        android:contentDescription="Rescan for devices"
        android:scaleType="centerInside"
        android:src="@drawable/ic_rescan_icon" />

    <ProgressBar
        android:id="@+id/scanProgressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignTop="@id/rescanButton"
        android:layout_alignStart="@id/rescanButton"
        android:layout_alignEnd="@id/rescanButton"
        android:layout_alignBottom="@id/rescanButton"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/connectionlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/rescanButton"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
