<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:background="?android:attr/selectableItemBackground"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/default_item_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/default_item_background">
        <TextView
            android:id="@+id/alarmName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Alarm Name"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_weight="1"
            android:layout_gravity="start"
            android:background="@drawable/transparent_background"
            android:layout_marginTop="2dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/alarmDay0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:background="@drawable/transparent_background"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/alarmDay1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:background="@drawable/transparent_background"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/alarmDay2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="W"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:background="@drawable/transparent_background"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/alarmDay3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:background="@drawable/transparent_background"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/alarmDay4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="F"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:background="@drawable/transparent_background"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/alarmDay5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:background="@drawable/transparent_background"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/alarmDay6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:background="@drawable/transparent_background"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginLeft="8dp"
        android:orientation="horizontal"
        android:background="@color/default_item_background">

        <CheckBox
            android:id="@+id/circularCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="10dp"
            android:button="@drawable/circular_checkbox_selector" />


        <!-- Display the alarm time -->
        <TextView
            android:id="@+id/textViewAlarmTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8:00 AM"
            android:textSize="38sp"
            android:textColor="@android:color/white"
            android:background="@drawable/transparent_background"/>

        <!-- Toggle switch for the alarm -->
        <Switch
            android:id="@+id/toggleAlarm"
            android:scaleY="1.5"
            android:scaleX="1.5"
            android:layout_marginRight="40dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
